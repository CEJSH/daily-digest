# Daily Digest 환경변수
# .env.local로 복사 후 값 채워서 사용 (.env.local은 gitignored)

# 일간 다이제스트 JSON 소스 URL (오늘의 호)
VITE_DIGEST_URL=http://localhost:8080/daily_digest.json

# (선택) 아카이브 data 디렉터리 base URL.
# index.json / archive/{날짜}.json 을 여기서 불러온다.
# 미설정 시 VITE_DIGEST_URL의 파일명을 잘라 자동 도출한다.
#   예: .../data/daily_digest.json → .../data
# 운영 예시:
# VITE_DIGEST_BASE=https://raw.githubusercontent.com/CEJSH/daily-news-digest/main/data

# 사이트 절대 URL — OG 메타태그(og:image, twitter:image)에 빌드 타임 주입.
# Vercel 배포 시: 프로젝트 환경변수에 production URL 설정.
# 예: https://daily-digest.vercel.app
VITE_SITE_URL=https://daily-digest.vercel.app
